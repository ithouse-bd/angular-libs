# npm stops at an unresolvable peer conflict in this workspace:
# @angular/animations is only published up to 20.1.8 and peer-requires
# @angular/common@20.1.8, while the rest of Angular resolves to 20.3.x.
# Installing with legacy peer resolution keeps the tree installable in CI;
# this file is not shipped with the published package.
legacy-peer-deps=true
